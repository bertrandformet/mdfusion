{
  "application": "MDFusion",
  "version": "2.0",
  "description": "Convertir et fusionner des documents en Markdown",
  "fonctionnalites": [
    "Conversion multi-formats",
    "Fusion de fichiers Markdown",
    "Editeur Markdown avec WYSIWYG"
  ],
  "formats_supportes": {
    "documents": ["pdf", "docx", "xlsx", "csv"],
    "web": ["html", "xml", "json"],
    "media": ["png", "jpg", "gif", "webp"],
    "livres": ["epub"]
  },
  "pwa": {
    "hors_ligne": true,
    "installable": true
  }
}
